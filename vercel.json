{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/cron/email-reminders.ts": {
      "maxDuration": 60
    },
    "api/admin/send-reminders.ts": {
      "maxDuration": 60
    },
    "api/admin/test-email.ts": {
      "maxDuration": 30
    },
    "api/admin/teachers.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/email-reminders",
      "schedule": "0 17 * * 4"
    }
  ]
}
