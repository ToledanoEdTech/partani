# ============================================================
# Environment Variables - EXAMPLE
# ============================================================
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored and will NOT be committed.
# For Vercel: add these as Environment Variables in the dashboard.
# ============================================================

# Firebase Web App Config
# Get these from: Firebase Console > Project Settings > Your apps > SDK setup
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Firestore database ID. Use "(default)" unless you created a named database.
VITE_FIREBASE_DATABASE_ID="(default)"

# Gemini AI API key (only required if using AI features)
GEMINI_API_KEY=""

# ============================================================
# Application URL — used by server-side email links.
# In production set to the canonical public URL (e.g. https://partani-topaz.vercel.app
# or a custom domain). The cron handler falls back to the partani-topaz URL
# if this is missing.
# ============================================================
APP_URL=""

# ============================================================
# Automated weekly email reminders — server-only (Vercel Cron)
# ------------------------------------------------------------
# These are NOT exposed to the browser. Do not prefix with VITE_.
# Configure them on Vercel under: Project → Settings → Environment Variables.
# ============================================================

# Gmail / Google Workspace SMTP credentials.
# We send mail through smtp.gmail.com:587 (STARTTLS) authenticated with
# an App Password, which avoids third-party domain verification entirely
# because Google already DKIM-signs outgoing messages for the
# authenticated user's domain.
#
# SMTP_USER:         the full Gmail / Workspace address that authenticates
#                    the SMTP session (e.g. partani@zvialod.com).
# SMTP_APP_PASSWORD: a 16-char App Password from
#                    https://myaccount.google.com/apppasswords
#                    (Security → 2-Step Verification → App passwords).
#                    Spaces are ignored — paste either "abcd efgh ijkl mnop"
#                    or "abcdefghijklmnop".
SMTP_USER=""
SMTP_APP_PASSWORD=""

# Optional. Sender address used in the "From:" header. Defaults to
# SMTP_USER if unset. The address part *must* match SMTP_USER or a
# configured Gmail alias — otherwise Gmail will silently rewrite the
# header. The "Display Name <address@domain>" format is supported and
# recommended, e.g.:
#   MAIL_FROM="מערכת דיווחים <partani@zvialod.com>"
MAIL_FROM=""

# Firebase Admin (service account) credentials. From Firebase Console →
# Project Settings → Service accounts → "Generate new private key".
# The private key contains literal newlines — escape them as "\n" when
# entering the value in the Vercel dashboard (the cron handler converts
# them back automatically).
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Optional: named Firestore database ID (defaults to "(default)" if unset).
# Should match VITE_FIREBASE_DATABASE_ID for consistency.
FIREBASE_ADMIN_DATABASE_ID="(default)"

# Vercel Cron auth — Vercel automatically sends `Authorization: Bearer ${CRON_SECRET}`
# on scheduled invocations when this variable is set. Use a long random string.
CRON_SECRET=""
